*.o
*.elf
*.bin
*.hex
*.lst
*.map

# Archivo de compilación C++ intermedio generado por el IDE
*.ino.cpp
*.ino.o

# Carpetas de compilación temporal que el IDE podría crear localmente
build/
out/

# 3. ARCHIVOS TEMPORALES Y DE SISTEMA
# ----------------------------------------------------
# Archivos temporales de editor
*~

# Archivos de sistema de macOS
.DS_Store

# Archivos de sistema de Windows
Thumbs.db
